# Address that receives x402 payments (your Base mainnet wallet)
PAY_TO_ADDRESS=

# Coinbase CDP API key — required by the production (mainnet) facilitator.
# Create one at https://portal.cdp.coinbase.com/ (Secret API Key).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Base mainnet RPC used to read live gas data.
# NOTE: this URL may contain a provider API key. It is never returned in
# responses; only the hostname is exposed as `rpcSource`.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# RPCs for the /gas/compare endpoint. All optional: public endpoints are used
# as defaults, so the comparison works with no extra configuration.
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Price per /gas call in USD. Defaults to 0.005 if unset.
# Comparable Base gas endpoints on x402 sit between $0.01 and $0.10.
GAS_PRICE_USD=0.005

# Price per /gas/compare call in USD. Defaults to 0.01 if unset.
# Higher than /gas because it reads four chains.
COMPARE_PRICE_USD=0.01

# Base Builder Code (ERC-8021 app code) advertised in the /gas 402 response
# for payment attribution. Defaults to bc_lhfd8zad if unset.
BUILDER_CODE=bc_lhfd8zad

PORT=4021

# --- Buyer / client (src/buyer.js) ---
# Funded Base mainnet private key (holds USDC) used to sign x402 payments.
# Never commit a real value.
BUYER_PRIVATE_KEY=
# Endpoint the buyer pays. Defaults to the live deployment if unset.
TARGET_URL=https://base-gas-x402-production.up.railway.app/gas
