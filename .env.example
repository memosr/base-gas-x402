# Address that receives x402 payments (your Base mainnet wallet)
PAY_TO_ADDRESS=

# Coinbase CDP API key — required by the production (mainnet) facilitator.
# Create one at https://portal.cdp.coinbase.com/ (Secret API Key).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Base mainnet RPC used to read live gas data.
# NOTE: this URL may contain a provider API key. It is never returned in
# responses; only the hostname is exposed as `rpcSource`.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# RPCs for the /gas/compare endpoint. All optional: each chain falls back to a
# list of public endpoints, so the comparison works with no extra configuration.
# Setting one here puts it first in that chain's fallback chain.
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
ETHEREUM_RPC_URL=

# Price per /gas call in USD. Defaults to 0.005 if unset.
# Comparable Base gas endpoints on x402 sit between $0.01 and $0.10.
GAS_PRICE_USD=0.005

# Price per /gas/compare call in USD. Defaults to 0.01 if unset.
# Higher than /gas because it reads four chains.
COMPARE_PRICE_USD=0.01

# Price per /gas/history call in USD. Defaults to 0.01 if unset.
HISTORY_PRICE_USD=0.01

# Price per /gas/cheapest-window call in USD. Defaults to 0.02 if unset.
WINDOW_PRICE_USD=0.02

# --- Gas history sampler ---
# How often to sample Base gas, in milliseconds. Defaults to 5 minutes.
# At 5 minutes, 7 days of history is ~2000 in-memory records.
HISTORY_SAMPLE_INTERVAL_MS=300000

# How long to retain samples, in hours. Defaults to 168 (7 days).
# Also caps the `hours` query parameter on the history endpoints.
HISTORY_RETENTION_HOURS=168

# --- Durable history (optional) ---
# Without these the sampler runs in memory only and every redeploy resets the
# buffer. With them, samples are mirrored to Upstash Redis and restored at boot.
# Reads are always served from memory, so this adds no request latency.
# Free tier is far more than enough: one write per sample, ~9k commands/month.
# Create a database at https://console.upstash.com and copy the REST values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis key holding the sample set. Only change this to run two independent
# histories against one database.
HISTORY_REDIS_KEY=base-gas:samples

# Base Builder Code (ERC-8021 app code) advertised in the /gas 402 response
# for payment attribution. Defaults to bc_lhfd8zad if unset.
BUILDER_CODE=bc_lhfd8zad

PORT=4021

# --- Buyer / client (src/buyer.js) ---
# Funded Base mainnet private key (holds USDC) used to sign x402 payments.
# Never commit a real value.
BUYER_PRIVATE_KEY=
# Endpoint the buyer pays. Defaults to the live deployment if unset.
TARGET_URL=https://base-gas-x402-production.up.railway.app/gas
