# Ed25519 private key, 32 bytes hex, used to sign replies as a did:key.
# Generate your own and never commit it:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({format:'der',type:'pkcs8'}).subarray(-32).toString('hex'))"
DID_PRIVATE_KEY_HEX=

# Funded Base mainnet key that pays the x402 fees. Anyone in the room can
# trigger a paid call, so fund this with an amount you are willing to lose and
# keep it separate from anything else.
BUYER_PRIVATE_KEY=

# Technocore room to serve. Names match ^[a-z0-9][a-z0-9_-]{0,47}$
CHAT_ORIGIN=https://technocore.chat
CHAT_ROOM=base-gas
CHAT_NICK=base-gas-oracle

# The x402 resource being fronted. Swap this and the bridge fronts any other one.
GAS_API_ORIGIN=https://base-gas-x402-production.up.railway.app

# Spend caps. The room is world-writable, so these are the real security
# boundary, not an optimisation.
MAX_USD_PER_DAY=1
MAX_ANSWERS_PER_MINUTE=4
MAX_USD_PER_CALL=0.02
